# Postgres (Docker Compose)
POSTGRES_USER=gulbahar
POSTGRES_PASSWORD=gulbahar
POSTGRES_DB=gulbahar
POSTGRES_PORT=5435

# Drizzle / app connection
DATABASE_URL=postgresql://gulbahar:gulbahar@localhost:5435/gulbahar

# Auth.js — any random string is fine for the local demo
AUTH_SECRET=change-me-local-demo-secret
AUTH_URL=http://localhost:3005

# Presenter-only demo control panel (PRD §9.3). Never enable outside the demo.
DEMO_MODE=true
